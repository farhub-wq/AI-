DB_URL=jdbc:mysql://127.0.0.1:3306/ai_customer_service?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=app_user
DB_PASSWORD=app_password

# 本地向量索引目录（配置名历史沿用 FAISS_*；实现为自研扁平索引 JSON 落盘，非 Faiss 原生库）
FAISS_INDEX_DIR=data/faiss-index

LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-with-your-llm-api-key
LLM_CHAT_MODEL=qwen-plus

# Embedding：强烈建议必配。未配置时回退本地 hash 向量，链路可跑通但检索质量差，不适合演示/验收。
EMBEDDING_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=replace-with-your-embedding-api-key
EMBEDDING_MODEL=text-embedding-v3

RAG_TOP_K=12
RAG_SCORE_THRESHOLD=0.22
RAG_MAX_CONTEXT_CHARS=6000
DAILY_QUESTION_LIMIT=100
DEFAULT_SUPPORT_KB_ID=1
DEFAULT_TECHNICAL_KB_ID=2

# LLM 超时/限流：最多尝试次数（含首次）+ 指数退避（毫秒）
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_MS=500
LLM_RETRY_MAX_DELAY_MS=8000
